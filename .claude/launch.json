{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "desk_tickets_server",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "http.server", "8743", "--directory", "output"],
      "port": 8743
    },
    {
      "name": "frontend_dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "frontend_dev_debug",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend"],
      "port": 5174,
      "autoPort": true
    }
  ]
}
